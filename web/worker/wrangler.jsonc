// The Worker that serves the browser build and keeps cloud saves.
//
// Static files (the Unity build in ./public, committed: see BUILDING.md) are served by
// Workers static assets; only /api/* runs this Worker's code. Saves live in D1.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orc-horde-fps",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orc-horde-saves",
      // Filled in once the database exists: `npx wrangler d1 create orc-horde-saves`.
      "database_id": "5c69ff96-47d4-4c28-9740-310c9c64e6bd",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}

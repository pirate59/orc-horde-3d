// The Worker that serves the browser build and keeps cloud saves.
//
// Static files (the Unity build in ../../Builds/Web) are served by Workers static
// assets; only /api/* runs this Worker's code. Saves live in D1.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orc-horde-fps",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../../Builds/Web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orc-horde-saves",
      // Filled in once the database exists: `npx wrangler d1 create orc-horde-saves`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
